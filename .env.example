# ============================================================================
# 1. Agent Execution Mode
# ============================================================================
# Options:
#   - "demo"    : Works out-of-the-box locally (no cloud keys needed, or uses OPENAI_API_KEY if set)
#   - "foundry" : Uses the live Microsoft Foundry Agent Service (azure-ai-projects 2.x SDK)
AGENT_MODE=demo

# ============================================================================
# 2. Microsoft Foundry Agent Service Configuration (for AGENT_MODE=foundry)
# ============================================================================
# Foundry portal (ai.azure.com) -> your project -> Overview -> Project endpoint
# (az_tui.sh -> Demo project -> "Write the selected Foundry project to .env" fills this in)
# Sign in with `az login`; your account needs the Foundry User role (formerly Azure AI User) on the project.
PROJECT_ENDPOINT=""
MODEL_DEPLOYMENT_NAME="gpt-4o"

# Optional: vector store to use. If empty, the demo creates one on the first run and reuses it after that
# (recorded in .kb_vector_store.json); only new or changed knowledge_base/ files are uploaded.
AZURE_VECTOR_STORE_ID=""

# Optional: Azure Function MCP server (written by ./deploy_feedback_function.sh). With FEEDBACK_MCP_URL and
# FEEDBACK_CONNECTION_NAME set, the agent's log_feedback tool (and, with DB_MODE=azure_blob, query_oracle_db and
# update_oracle_incident) are MCP tools on an Azure Function that Foundry calls itself, so they also work in the
# portal playground; the function's key lives only in that Foundry project connection.
# FEEDBACK_TABLE_ENDPOINT makes the app read (and, in demo mode, write) the same Azure Table; without it, the
# app uses feedback_log.jsonl.
FEEDBACK_MCP_URL=""
FEEDBACK_CONNECTION_NAME=""
FEEDBACK_TABLE_ENDPOINT=""
FEEDBACK_TABLE_NAME="feedback"

# Optional: OpenAI / Azure OpenAI key for intelligent LLM responses in local "demo" mode
OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT="gpt-4o"

# ============================================================================
# 3. Oracle Database Configuration
# ============================================================================
# Options:
#   - "sqlite_mock" : Pre-seeded local Oracle-compatible SQLite database (default for instant demo)
#   - "azure_blob"  : The same mock database kept as a blob in Azure Storage (ORACLE_MOCK_BLOB_URL), shared with
#                     the Azure Function that serves the DB tools to Foundry; needs az login
#   - "oracle_live" : Connects to a live Oracle Database via python-oracledb (Thin mode)
DB_MODE=sqlite_mock
ORACLE_MOCK_BLOB_URL=""

# Live Oracle DB credentials (used when DB_MODE=oracle_live)
ORACLE_USER="system"
ORACLE_PASSWORD="your_oracle_password"
ORACLE_DSN="localhost:1521/FREEPDB1"

# ============================================================================
# 4. Guardrail Policy Settings
# ============================================================================
REQUIRE_HITL_FOR_KB_UPDATE=true
REQUIRE_HITL_FOR_DB_WRITE=true
ENFORCE_SQL_READONLY=true
ENFORCE_PII_SCAN=true
